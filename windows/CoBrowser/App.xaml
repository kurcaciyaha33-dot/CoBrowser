<Application x:Class="CoBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- CoBrowser "Chrome x Bing" design tokens.
         Structure and neutrals follow Chrome's dark UI; accents follow Bing / Microsoft (blue-teal). -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202124" />
    <SolidColorBrush x:Key="TabStripBrush" Color="#202124" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#35363A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#292A2D" />
    <SolidColorBrush x:Key="ActiveTabBrush" Color="#35363A" />
    <SolidColorBrush x:Key="OmniboxBrush" Color="#202124" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="BorderBrushCo" Color="#4B4D52" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="HoverBrush" Color="#44474B" />
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#3C4043" />
    <SolidColorBrush x:Key="IconBrush" Color="#BDC1C6" />
    <SolidColorBrush x:Key="BingTealBrush" Color="#2DC4D0" />

    <!-- Bing-style blue to teal gradient (white text stays readable on it). -->
    <LinearGradientBrush x:Key="BingGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#0B6FCB" Offset="0" />
      <GradientStop Color="#0A7F8F" Offset="1" />
    </LinearGradientBrush>
    <!-- Brighter version for large display text and decorative glow only. -->
    <LinearGradientBrush x:Key="BingTitleBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#6CB6FF" Offset="0" />
      <GradientStop Color="#2DD4BF" Offset="1" />
    </LinearGradientBrush>
    <!-- Chrome four-colour accent line (hard stops). -->
    <LinearGradientBrush x:Key="ChromeStripeBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#4285F4" Offset="0" /><GradientStop Color="#4285F4" Offset="0.25" />
      <GradientStop Color="#EA4335" Offset="0.25" /><GradientStop Color="#EA4335" Offset="0.5" />
      <GradientStop Color="#FBBC04" Offset="0.5" /><GradientStop Color="#FBBC04" Offset="0.75" />
      <GradientStop Color="#34A853" Offset="0.75" /><GradientStop Color="#34A853" Offset="1" />
    </LinearGradientBrush>

    <!-- Original CoBrowser vector icon pack. Every toolbar symbol is drawn as a WPF vector. -->
    <Geometry x:Key="Icon.Back">M14.5,5 L7.5,12 L14.5,19 M7.5,12 H20</Geometry>
    <Geometry x:Key="Icon.Forward">M9.5,5 L16.5,12 L9.5,19 M16.5,12 H4</Geometry>
    <Geometry x:Key="Icon.Reload">M20,11 A8,8 0 0 0 5.2,8 L3,11 M3,5 V11 H9 M4,13 A8,8 0 0 0 18.8,16 L21,13 M21,19 V13 H15</Geometry>
    <Geometry x:Key="Icon.Home">M3,10.8 L12,3 L21,10.8 M5.5,9.5 V21 H18.5 V9.5 M9.5,21 V15 H14.5 V21</Geometry>
    <Geometry x:Key="Icon.Search">M20.5,20.5 L15.8,15.8 M17,10.5 A6.5,6.5 0 1 1 4,10.5 A6.5,6.5 0 1 1 17,10.5 Z</Geometry>
    <Geometry x:Key="Icon.Bookmark">M6,3.5 H18 V21 L12,16.5 L6,21 Z</Geometry>
    <Geometry x:Key="Icon.Download">M12,3 V15 M7,10 L12,15 L17,10 M4,19 H20</Geometry>
    <Geometry x:Key="Icon.Menu">M4,6 H20 M4,12 H20 M4,18 H20</Geometry>
    <Geometry x:Key="Icon.Plus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="Icon.User">M20,21 A8,8 0 0 0 4,21 M12,12 A4.2,4.2 0 1 0 12,3.6 A4.2,4.2 0 0 0 12,12 Z</Geometry>
    <Geometry x:Key="Icon.Globe">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M3.5,12 H20.5 M12,3 A15,15 0 0 1 12,21 M12,3 A15,15 0 0 0 12,21</Geometry>
    <Geometry x:Key="Icon.Code">M8,7 L3,12 L8,17 M16,7 L21,12 L16,17 M14,4 L10,20</Geometry>
    <Geometry x:Key="Icon.Folder">M3,7.5 H10 L12,9.5 H21 V19.5 H3 Z M3,7.5 V5 H10 L12,7</Geometry>
    <Geometry x:Key="Icon.Mail">M3,6 H21 V18 H3 Z M3,7 L12,13.5 L21,7</Geometry>
    <Geometry x:Key="Icon.Play">M8,5.5 V18.5 L19,12 Z</Geometry>
    <Geometry x:Key="Icon.Book">M4,4.5 H11 A3,3 0 0 1 14,7.5 V20 A3,3 0 0 0 11,17 H4 Z M20,4.5 H14 V20 A3,3 0 0 1 17,17 H20 Z</Geometry>
    <Geometry x:Key="Icon.Grid">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
    <Geometry x:Key="Icon.Shield">M12,3 L19.5,6 V11.5 C19.5,16 16.5,19.5 12,21 C7.5,19.5 4.5,16 4.5,11.5 V6 Z M8.8,12 L11.2,14.4 L15.4,9.8</Geometry>
    <Geometry x:Key="Icon.Settings">M12,8.5 A3.5,3.5 0 1 1 12,15.5 A3.5,3.5 0 1 1 12,8.5 Z M19,13.5 A7.8,7.8 0 0 0 19,10.5 L21,9 L19,5.6 L16.6,6.6 A8,8 0 0 0 14,5.1 L13.6,2 H10.4 L10,5.1 A8,8 0 0 0 7.4,6.6 L5,5.6 L3,9 L5,10.5 A7.8,7.8 0 0 0 5,13.5 L3,15 L5,18.4 L7.4,17.4 A8,8 0 0 0 10,18.9 L10.4,22 H13.6 L14,18.9 A8,8 0 0 0 16.6,17.4 L19,18.4 L21,15 Z</Geometry>

    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="19">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value=".68" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".32" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style x:Key="SecondaryActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BingTealBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value=".72" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style x:Key="ProfileButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="Margin" Value="4,0,2,0" />
    </Style>
    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Width" Value="23" /><Setter Property="Height" Value="23" /><Setter Property="Margin" Value="5,0,0,0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="3,6,2,0" />
      <Setter Property="MinWidth" Value="132" /><Setter Property="MaxWidth" Value="240" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ActiveTabBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SignInButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource BingGradientBrush}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="22,10" />
      <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".92"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Round Bing-style search button used inside the big search box. -->
    <Style x:Key="BingSearchButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BingGradientBrush}" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="20"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SearchActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShortcutButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="Transparent" CornerRadius="15" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShortcutIconBorder" TargetType="Border">
      <Setter Property="Width" Value="58" /><Setter Property="Height" Value="58" /><Setter Property="CornerRadius" Value="29" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="ShortcutLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxWidth" Value="84" />
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HasDropShadow" Value="True" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="190" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
