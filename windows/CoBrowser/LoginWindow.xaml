<Window x:Class="CoBrowser.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to CoBrowser" Width="980" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#202124" Foreground="#E8EAED" Icon="Assets/cobrowser.ico">
  <Window.Resources>
    <!-- Official four-colour Google "G" (24x24 grid). -->
    <Geometry x:Key="G.Blue">M22.56,12.25 C22.56,11.47 22.49,10.72 22.36,10 H12 V14.26 H17.92 C17.66,15.63 16.88,16.79 15.71,17.57 V20.34 H19.28 C21.36,18.42 22.56,15.6 22.56,12.25 Z</Geometry>
    <Geometry x:Key="G.Green">M12,23 C14.97,23 17.46,22.02 19.28,20.34 L15.71,17.57 C14.73,18.23 13.48,18.63 12,18.63 C9.14,18.63 6.71,16.7 5.84,14.1 H2.18 V16.94 C3.99,20.53 7.7,23 12,23 Z</Geometry>
    <Geometry x:Key="G.Yellow">M5.84,14.09 C5.62,13.43 5.49,12.73 5.49,12 C5.49,11.27 5.62,10.57 5.84,9.91 V7.07 H2.18 C1.43,8.55 1,10.22 1,12 C1,13.78 1.43,15.45 2.18,16.93 L5.03,14.71 L5.84,14.09 Z</Geometry>
    <Geometry x:Key="G.Red">M12,5.38 C13.62,5.38 15.06,5.94 16.21,7.02 L19.36,3.87 C17.45,2.09 14.97,1 12,1 C7.7,1 3.99,3.47 2.18,7.07 L5.84,9.91 C6.71,7.31 9.14,5.38 12,5.38 Z</Geometry>

    <Style x:Key="LinkText" TargetType="Button">
      <Setter Property="Foreground" Value="#8AB4F8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1F8AB4F8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="28,22,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Image Source="Assets/cobrowser-mark.png" Width="34" Height="34" Margin="0,0,12,0"/>
        <TextBlock Text="CoBrowser" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="VERSION 1.0.1" DockPanel.Dock="Right" Foreground="#9AA0A6" FontSize="10" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Sign-in card (Chrome layout, Bing accents) -->
    <Border Grid.Row="1" Background="#0F1011" BorderBrush="#2E3033" BorderThickness="1" CornerRadius="28" Margin="0,22,0,14" Padding="0">
      <Grid>
        <Rectangle Height="3" VerticalAlignment="Top" Margin="48,0,48,0" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource ChromeStripeBrush}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="48,40,48,32" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="280"/>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="1.1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: logo, title, description -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <Viewbox Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,26">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource G.Blue}" Fill="#4285F4"/>
                  <Path Data="{StaticResource G.Green}" Fill="#34A853"/>
                  <Path Data="{StaticResource G.Yellow}" Fill="#FBBC05"/>
                  <Path Data="{StaticResource G.Red}" Fill="#EA4335"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Sign in to CoBrowser" FontSize="34" FontWeight="Normal" TextWrapping="Wrap" Foreground="#E8EAED"/>
              <TextBlock Text="Sign in with your Google email address. Gmail and Google Workspace accounts are supported." FontSize="16" LineHeight="26" Foreground="#C4C7C5" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>

            <!-- Right: email field, secure-sign-in note, actions -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <!-- Outlined field with floating label, like Chrome's "Email or phone" -->
              <Grid Height="68">
                <Border x:Name="EmailOutline" BorderThickness="1" BorderBrush="#8AB4F8" CornerRadius="4" Margin="0,8,0,0" Background="Transparent">
                  <TextBox x:Name="EmailBox" Margin="0" Padding="16,0" FontSize="17" VerticalContentAlignment="Center"
                           Foreground="#E8EAED" CaretBrush="#E8EAED" Background="Transparent" BorderThickness="0"
                           AutomationProperties.Name="Google email" InputScope="EmailSmtpAddress"
                           KeyDown="EmailBox_KeyDown" TextChanged="EmailBox_TextChanged"
                           GotKeyboardFocus="EmailBox_FocusChanged" LostKeyboardFocus="EmailBox_FocusChanged"/>
                </Border>
                <TextBlock x:Name="EmailLabel" Text="Google email" FontSize="12" Foreground="#8AB4F8"
                           Background="#0F1011" Padding="5,0" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
              </Grid>
              <TextBlock x:Name="EmailError" Text="" FontSize="12" Foreground="#F28B82" TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
              <Button Content="Forgot email?" Style="{StaticResource LinkText}" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="ForgotEmail_Click"/>

              <!-- Secure sign-in note (replaces Chrome's passkey tile) -->
              <Border Background="#1E1F20" CornerRadius="24" Padding="20,16" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.Shield}" Stroke="{StaticResource BingTealBrush}" StrokeThickness="1.7"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,14,0"/>
                  <StackPanel MaxWidth="330">
                    <TextBlock Text="Secure Google sign-in" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED"/>
                    <TextBlock Text="Google sign-in opens in a secure browser window. Your password and passkey are entered only on Google's official page, never inside CoBrowser."
                               FontSize="12.5" LineHeight="19" Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Actions -->
              <DockPanel Margin="0,28,0,0" LastChildFill="False">
                <Button x:Name="NextButton" Content="Next" DockPanel.Dock="Right" Style="{StaticResource SignInButton}" MinWidth="92" Click="NextButton_Click" IsDefault="True"/>
                <Button Content="Create account" DockPanel.Dock="Right" Style="{StaticResource LinkText}" Margin="0,0,10,0" Click="CreateAccount_Click"/>
              </DockPanel>
              <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#9AA0A6" TextWrapping="Wrap" TextAlignment="Right" Margin="0,12,0,0"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Footer: users only enter their Google email. OAuth app configuration is publisher-side. -->
    <StackPanel Grid.Row="2">
      <Border x:Name="ConfigurationNotice" Visibility="Collapsed" Background="#2A211F" BorderBrush="#70433D" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
        <TextBlock Text="Google sign-in is not configured in this app build. Please ask the CoBrowser publisher for a configured release. No account ID or password should be entered here."
                   FontSize="11.5" Foreground="#F2B8B5" TextWrapping="Wrap" />
      </Border>
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="CoCo X Who?  •  CoBrowser 1.0.1" Foreground="#9AA0A6" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" Text="Google email sign-in" Foreground="#9AA0A6" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
