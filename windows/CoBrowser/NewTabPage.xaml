<UserControl x:Class="CoBrowser.NewTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBrush}">
  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.7">
          <GradientStop Color="#3D00B7C3" Offset="0" />
          <GradientStop Color="#1F0B6FCB" Offset="0.45" />
          <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="30,0,32,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Content="Gmail" Style="{StaticResource LinkButton}" Click="Gmail_Click"/>
        <Button Content="Images" Style="{StaticResource LinkButton}" Click="Images_Click"/>
        <Button x:Name="AccountButton" Content="Google account" Style="{StaticResource SignInButton}" Click="SignIn_Click" Margin="12,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="650">
        <StackPanel Width="720" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26,20,26,52">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Image Source="/CoBrowser;component/Assets/cobrowser-mark.png" Width="70" Height="70" Margin="0,0,15,0" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="CoBrowser" FontSize="45" FontWeight="SemiBold" Foreground="{StaticResource BingTitleBrush}"/>
              <TextBlock Text="Explore the web. Keep your flow." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="3,1,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Ellipse Width="7" Height="7" Fill="#4285F4" Margin="3,0"/><Ellipse Width="7" Height="7" Fill="#EA4335" Margin="3,0"/>
            <Ellipse Width="7" Height="7" Fill="#FBBC04" Margin="3,0"/><Ellipse Width="7" Height="7" Fill="#34A853" Margin="3,0"/>
          </StackPanel>

          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="29" Height="58" Padding="22,0,9,0" Margin="0,0,0,18">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" />
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" FontSize="16" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Search Bing or Google, or type a URL" Foreground="{DynamicResource MutedBrush}" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Button Grid.Column="2" Style="{StaticResource BingSearchButton}" Click="Search_Click" ToolTip="Search">
                <Path Data="{StaticResource Icon.Search}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,44">
            <Button Content="Search" Style="{StaticResource SignInButton}" Click="Search_Click" Margin="4,0"/>
            <Button Content="I'm Feeling Lucky" Style="{StaticResource SearchActionButton}" Click="Lucky_Click" Margin="4,0"/>
          </StackPanel>

          <TextBlock Text="YOUR SHORTCUTS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <UniformGrid x:Name="ShortcutGrid" Columns="7" HorizontalAlignment="Center">
            <Button Tag="https://www.google.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Globe}" Stroke="#72B7FF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Google" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://www.bing.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Search}" Stroke="{StaticResource BingTealBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Bing" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://mail.google.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Mail}" Stroke="#F28B82" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Gmail" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://www.youtube.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Play}" Stroke="#FF7777" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="YouTube" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://drive.google.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Folder}" Stroke="#78C89A" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Drive" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://github.com" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Code}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="GitHub" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
            <Button Tag="https://www.wikipedia.org" Click="Shortcut_Click" Style="{StaticResource ShortcutButton}"><StackPanel><Border Style="{StaticResource ShortcutIconBorder}"><Path Data="{StaticResource Icon.Book}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Wikipedia" Style="{StaticResource ShortcutLabel}"/></StackPanel></Button>
          </UniformGrid>

          <Border x:Name="LoginGatePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushCo}" BorderThickness="1" CornerRadius="18" Padding="23" Margin="0,38,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Welcome to CoBrowser" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Sign in with your Google email to unlock this browser profile." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,8,12,17"/>
              <Button Content="Sign in with Google" Style="{StaticResource SignInButton}" HorizontalAlignment="Center" Click="SignIn_Click"/>
              <TextBlock Text="You enter your Google email, then Google opens in your browser for secure sign-in. CoBrowser stores a separate encrypted app identity; it does not copy Chrome passwords, cookies, or Chrome Sync." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,14,12,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="CoBrowser 1.0.1" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
</UserControl>
