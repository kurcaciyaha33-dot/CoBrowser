<Window x:Class="CoBrowser.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find on page" Width="390" Height="145" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#292A2D" Foreground="#E8EAED">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="QueryBox" Height="36" Padding="10,7" VerticalContentAlignment="Center" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="82" Height="30" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Find" Width="82" Height="30" IsDefault="True" Click="Find_Click" />
    </StackPanel>
  </Grid>
</Window>
