<Window x:Class="CoBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoBrowser" Icon="Assets/cobrowser.ico" Height="920" Width="1480" MinHeight="650" MinWidth="980"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="25" />
    </Grid.RowDefinitions>

    <!-- Tab strip -->
    <Grid Grid.Row="0" Background="{DynamicResource TabStripBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="Transparent" ToolTip="CoBrowser" VerticalAlignment="Stretch">
        <Image Source="/CoBrowser;component/Assets/cobrowser-mark.png" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TabControl x:Name="Tabs" Grid.Column="1" Background="Transparent" BorderThickness="0"
                  SelectionChanged="Tabs_SelectionChanged" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True" Background="Transparent"/></ControlTemplate></TabControl.Template>
      </TabControl>
      <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="34" Height="34" Margin="4,5,8,5" Click="NewTab_Click" ToolTip="New tab (Ctrl+T)">
        <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
    </Grid>

    <!-- Navigation toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource ToolbarBrush}" Padding="12,8">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Click="Back_Click" ToolTip="Back">
            <Path Data="{StaticResource Icon.Back}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Click="Forward_Click" ToolTip="Forward">
            <Path Data="{StaticResource Icon.Forward}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButton}" Click="Reload_Click" ToolTip="Reload">
            <Path Data="{StaticResource Icon.Reload}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="Home_Click" ToolTip="Home / New tab">
            <Path Data="{StaticResource Icon.Home}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <Border Grid.Column="1" Background="{DynamicResource OmniboxBrush}"
                CornerRadius="22" Height="42" VerticalAlignment="Center" Padding="15,0" Margin="16,0,16,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCo}" />
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                  <Setter Property="BorderThickness" Value="2" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="{StaticResource Icon.Globe}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBox x:Name="AddressBox" Grid.Column="1" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"
                     GotKeyboardFocus="AddressBox_GotKeyboardFocus" ToolTip="Search with Bing or Google, or enter a URL" FontSize="14"/>
            <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="32" Height="32" Click="AddressSearch_Click" ToolTip="Search">
              <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/>
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BookmarkButton" Style="{StaticResource ToolbarButton}" Click="Bookmark_Click" ToolTip="Bookmark this page (Ctrl+D)">
            <Path Data="{StaticResource Icon.Bookmark}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button x:Name="DownloadsButton" Style="{StaticResource ToolbarButton}" Click="DownloadsButton_Click" ToolTip="Downloads (Ctrl+J)">
            <Path Data="{StaticResource Icon.Download}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
          </Button>
          <Button x:Name="ProfileButton" Style="{StaticResource ProfileButton}" Click="Profile_Click" ToolTip="CoBrowser Google profile">
            <Grid Width="29" Height="29">
              <Ellipse Fill="{StaticResource BingGradientBrush}"/>
              <TextBlock x:Name="ProfileInitialText" Text="C" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="Menu_Click" ToolTip="Customize and control CoBrowser">
            <Path Data="{StaticResource Icon.Menu}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity=".9" Fill="{StaticResource ChromeStripeBrush}"/>

    <!-- Selected native page or CEF browser view -->
    <Grid Grid.Row="2" x:Name="BrowserHost" Background="{DynamicResource WindowBrush}" ClipToBounds="True"/>

    <Border Grid.Row="3" Background="{DynamicResource TabStripBrush}" Padding="14,3">
      <Grid>
        <TextBlock x:Name="StatusText" Text="CoBrowser · Chromium" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>

    <!-- Chrome-inspired downloads flyout; the full downloads page is available from this panel. -->
    <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Width="390" MaxHeight="520" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrushCo}" BorderThickness="1" CornerRadius="14"
              Padding="16" SnapsToDevicePixels="True">
        <StackPanel>
          <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="Recent downloads" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="View all" Style="{DynamicResource LinkButton}" Padding="8,4" Click="OpenDownloadsPage_Click" />
          </DockPanel>
          <TextBlock x:Name="DownloadsFlyoutEmpty" Text="No downloads yet" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     HorizontalAlignment="Center" Margin="0,26,0,26" />
          <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DownloadsFlyoutList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrushCo}" BorderThickness="0,0,0,1" Padding="4,11">
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                      <ProgressBar Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                   Value="{Binding PercentComplete}" IsIndeterminate="{Binding IsIndeterminate}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="Saved to CoBrowser Downloads" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Open folder" Style="{DynamicResource SecondaryActionButton}" Padding="10,6" Click="OpenDownloadsFolder_Click" />
          </DockPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
