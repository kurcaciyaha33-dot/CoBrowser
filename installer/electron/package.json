{
  "name": "cobrowser-electron-installer",
  "version": "1.0.5",
  "private": true,
  "description": "CoBrowser 1.0.5 Windows installer UI",
  "main": "main.cjs",
  "author": "CoCo X Who?",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:windows": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.cocoxwho.cobrowser.setup",
    "productName": "CoBrowser Setup",
    "executableName": "CoBrowser-Setup",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "win": {
      "icon": "assets/cobrowser.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "CoBrowser-Setup-${version}-${arch}.exe"
    },
    "icon": "assets/cobrowser.ico"
  }
}
